# Configuración de MySQL
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=miaumiau_db
MYSQL_USER=miaumiau_user
MYSQL_PASSWORD=miaumiau_password
MYSQL_PORT=3306

# Google Maps servidor (Geocoding, Directions, Distance Matrix). Restringir por IP del servidor.
# Sin esta llave el GPS del repartidor sí se guarda; no hay polyline ni ETA.
GOOGLE_MAPS_API_KEY=

# Configuración de WhatsApp
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_REOPEN_TEMPLATE_NAME=saludo_inicial
